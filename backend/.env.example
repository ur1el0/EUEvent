APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
SANCTUM_EXPIRATION_MINUTES=1440

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sending real email with Brevo's SMTP relay (see docs/setup-guide.md, "Sending real email with Brevo").
# Put real values in your own ignored .env, never in this file, then run: php artisan config:clear
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# Port 587 uses STARTTLS, which the "smtp" scheme negotiates. Use "smtps" only with port 465.
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Must be a sender you verified in Brevo.
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="EUEvent"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local testing only. Used by `php artisan db:seed --class=LocalStudentSeeder`.
# Leave blank unless you need the test student; must be at least 12 characters.
LOCAL_STUDENT_PASSWORD=

# Student self-registration (ADR 016). Defaults are shown; the allowed domains are matched exactly.
# With MAIL_MAILER=log the one-time code appears in storage/logs/laravel.log. Never use that mailer for real users.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=student.mseuf.edu.ph,mseuf.edu.ph
REGISTRATION_CODE_LENGTH=6
REGISTRATION_CODE_LIFETIME_MINUTES=15
REGISTRATION_MAX_VERIFY_ATTEMPTS=5
REGISTRATION_RESEND_COOLDOWN_SECONDS=60
